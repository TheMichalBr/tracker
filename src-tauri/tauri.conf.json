{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tracker",
  "version": "1.0.2",
  "identifier": "com.tracker.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tracker",
        "width": 1240,
        "height": 840,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0b0f19",
        "visible": false,
        "devtools": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
